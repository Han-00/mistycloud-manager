# 运行时数据 — 含账号凭据与密钥，绝不入库
accounts.json
settings.json
*.log
*.tmp

# v2ray 二进制运行时（自动从 Misty 目录复制）
v2ray_work/

# 打包产物与缓存
build/
dist/
# build_dist.py 每次构建会把旧目录改名成 build_stale_<时间> 挪开
# （见该文件 clean_old：不能 rmtree，批删会触发安全网关拦截）。
# 注意 `build/` 只匹配目录本身，匹配不到这个前缀，必须单独写。
build_stale_*/
__pycache__/
*.pyc

# 打包出的 exe 一律不入库
*.exe

# 运行时统计数据
stats.json
# events 事件流（换号留痕，含邮箱等运行时信息）
events.jsonl
events.jsonl.*

# WorkBuddy 项目工作区（记忆/日志等本地数据）
.workbuddy/

# 本地浏览器验收产物
.playwright-cli/
output/playwright/

# 本机诊断草稿和历史数据副本
/_diag_*
/_hist_copy.db

# 旧 Android MOD 原型；现版在 Han-00/misty-android-mod 独立维护
/android-mod/
